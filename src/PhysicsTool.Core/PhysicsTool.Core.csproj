<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>PhysicsTool</RootNamespace>
    <DebugType Condition="'$(Configuration)' == 'Release'">none</DebugType>
    <DebugSymbols Condition="'$(Configuration)' == 'Release'">false</DebugSymbols>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../PhysicsTool/Formats/**/*.cs" Exclude="../../PhysicsTool/Formats/Actors/ToolboxActorTexture.cs" LinkBase="Formats" />
    <Compile Include="../../PhysicsTool/Editor/Viewport/BfresModelPose.cs" Link="Models/BfresModelPose.cs" />
    <Compile Include="../../PhysicsTool/UI/UserFacingExceptionFormatter.cs" Link="UserFacingExceptionFormatter.cs" />
    <Compile Include="../../PhysicsTool/ThirdParty/Toolbox/*.cs" LinkBase="ThirdParty/Toolbox" />
    <Compile Include="../../PhysicsTool/ThirdParty/ToolboxAstc/*.cs" LinkBase="ThirdParty/ToolboxAstc" />
    <Compile Include="../../PhysicsTool/Editor/Models/*.cs" LinkBase="Models" />
    <Compile Include="../../PhysicsTool/Editor/Simulation/*.cs" LinkBase="Simulation" />
    <Compile Include="../../PhysicsTool/Editor/Viewport/VisualModelData.cs" Link="Models/VisualModelData.cs" />
    <EmbeddedResource Include="../../PhysicsTool/Formats/Bphcl/Resources/*.bin" Link="Formats/Bphcl/Resources/%(Filename)%(Extension)" />
    <EmbeddedResource Include="../../PhysicsTool/Formats/Collision/IceHail/**/*.js" LinkBase="Formats/Collision/IceHail" />
    <EmbeddedResource Include="../../PhysicsTool/Formats/Collision/IceHail/compound.json" Link="Formats/Collision/IceHail/compound.json" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Tkmm.BymlLibrary" Version="1.2.3" />
    <PackageReference Include="MIConvexHull" Version="1.1.19.1019" />
    <PackageReference Include="ZstdSharp.Port" Version="0.8.8" />
    <PackageReference Include="AssimpNetter" Version="6.0.5" />
    <PackageReference Include="Jint" Version="4.16.1" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
    <PackageReference Include="BotW-HKX2" Version="1.0.0" />
    <PackageReference Include="BCnEncoder.Net" Version="2.3.0" />
    <Reference Include="Syroot.BinaryData"><HintPath>../../PhysicsTool/ThirdParty/Toolbox/Syroot.BinaryData.dll</HintPath></Reference>
    <Reference Include="Syroot.Maths"><HintPath>../../PhysicsTool/ThirdParty/Toolbox/Syroot.Maths.dll</HintPath></Reference>
    <Reference Include="Syroot.NintenTools.Bfres"><HintPath>../../PhysicsTool/ThirdParty/Toolbox/Syroot.NintenTools.Bfres.dll</HintPath></Reference>
    <Reference Include="Syroot.NintenTools.NSW.Bfres"><HintPath>../../PhysicsTool/ThirdParty/Toolbox/Syroot.NintenTools.NSW.Bfres.dll</HintPath></Reference>
    <Reference Include="Syroot.NintenTools.NSW.Bntx"><HintPath>../../PhysicsTool/ThirdParty/Toolbox/Syroot.NintenTools.NSW.Bntx.dll</HintPath></Reference>
    <InternalsVisibleTo Include="PhysicsTool" />
    <InternalsVisibleTo Include="PhysicsTool.Checks" />
  </ItemGroup>
  <ItemGroup>
    <None Include="../../PhysicsTool/ThirdParty/ToolboxAstc/LICENSE;../../PhysicsTool/ThirdParty/ToolboxAstc/SOURCES.txt" Link="Licenses/ToolboxAstc/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Include="../../PhysicsTool/ThirdParty/MeshCodec/runtimes/**/*" Exclude="../../PhysicsTool/ThirdParty/MeshCodec/runtimes/**/*.pdb;../../PhysicsTool/ThirdParty/MeshCodec/runtimes/**/*.lib" Link="Tools/MeshCodec/%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Include="$(IntermediateOutputPath)MeshCodec-source.zip" Link="Licenses/MeshCodec-source.zip" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
  <Target Name="PackageMeshCodecSource" BeforeTargets="BeforeBuild">
    <RemoveDir Directories="$(IntermediateOutputPath)MeshCodec-source" />
    <MakeDir Directories="$(IntermediateOutputPath)" />
    <ItemGroup>
      <MeshCodecSource Include="../../PhysicsTool/ThirdParty/MeshCodec/**/*" Exclude="../../PhysicsTool/ThirdParty/MeshCodec/runtimes/**/*" />
    </ItemGroup>
    <Copy SourceFiles="@(MeshCodecSource)" DestinationFiles="@(MeshCodecSource->'$(IntermediateOutputPath)MeshCodec-source/%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
    <ZipDirectory SourceDirectory="$(IntermediateOutputPath)MeshCodec-source" DestinationFile="$(IntermediateOutputPath)MeshCodec-source.zip" Overwrite="true" />
  </Target>
</Project>
