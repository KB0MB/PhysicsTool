<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ApplicationIcon>../../PhysicsTool/Resources/Branding/PhysicsTool.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../PhysicsTool.Core/PhysicsTool.Core.csproj" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.3" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.3" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.3" />
    <PackageReference Include="Silk.NET.OpenGL" Version="2.23.0" />
    <PackageReference Include="Lucide.Avalonia" Version="0.2.20" />
    <EmbeddedResource Include="Rendering/Shaders/*" />
    <EmbeddedResource Include="../../PhysicsTool/Resources/VisualModel/*.png" Link="Textures/%(Filename)%(Extension)" />
    <AvaloniaResource Include="../../PhysicsTool/Resources/Branding/PhysicsTool.png" Link="Assets/PhysicsTool.png" />
    <None Include="../../LICENSE" Link="LICENSE" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../../THIRD_PARTY_NOTICES.txt" Link="THIRD_PARTY_NOTICES.txt" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../../PhysicsTool/ThirdParty/AssimpNetter-LICENSE.txt" Link="Licenses/AssimpNetter-LICENSE.txt" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../../PhysicsTool/ThirdParty/BCnEncoder-LICENSE.txt" Link="Licenses/BCnEncoder-LICENSE.txt" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../../PhysicsTool/ThirdParty/Toolbox/LICENSE.txt" Link="Licenses/Toolbox-LICENSE.txt" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../../PhysicsTool/ThirdParty/Toolbox/SOURCES.txt" Link="Licenses/Toolbox-SOURCES.txt" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
